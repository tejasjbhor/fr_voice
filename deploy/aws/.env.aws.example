# Copy to .env on the EC2 box (never commit real secrets).
# Fill values from your laptop D:\fr_voice\.env

PYTHONUNBUFFERED=1
PORT=8000
APP_ENV=development
PRODUCT=health

# ── Public URL after HTTPS works (Step 6) ──
SERVER_PUBLIC_URL=https://REPLACE_WITH_YOUR_HTTPS_HOST

# ── 2 concurrent calls ──
MAX_CONCURRENT_CALLS=2
CALL_SLOTS_BACKEND=memory
SARVAM_STT_MAX_INFLIGHT=2
SARVAM_TTS_MAX_INFLIGHT=2
SARVAM_STT_POOL_LIMIT=2
SARVAM_TTS_POOL_LIMIT=2
CLAUDE_MAX_INFLIGHT=2
OPEN_DIALER=true
SCHEDULER_ENABLED=0
AUTO_DIAL_ON_START=false
OUTBOUND_CPS=1

# ── Plivo (India) ──
TELEPHONY_PROVIDER=plivo
OUTBOUND_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=+912269854791

# ── Claude ──
LLM_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MODEL_MR=claude-sonnet-4-6

# ── Sarvam (EN/HI/MR only) ──
SARVAM_API_KEY=
TTS_PROVIDER_EN=sarvam
TTS_PROVIDER_HI=sarvam
TTS_PROVIDER_MR=sarvam
STT_PROVIDER_EN=sarvam
STT_PROVIDER_HI=sarvam
STT_PROVIDER_MR=sarvam

# ── Latency knobs ──
THINKING_SOUND_ENABLED=true
THINKING_SOUND_THRESHOLD_MS=800
VAD_SILENCE_CHUNKS=6
TTS_MIN_EARLY_CHARS=16
POST_TTS_LISTEN_GAP_S=0.25
PROVIDER_HANGUP_ENABLED=true
RECORD_CALL=true
RECORDINGS_DIR=recordings

APP_SECRET=change-me-long-random
ALLOW_TEST_OTP=1
TEST_OTP=123456
ADMIN_PIN=2499
SMS_OTP=false
