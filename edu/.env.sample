# SAMPLE ONLY — no real secrets. Copy to project-root `.env` for education product.
# The phone app loads ROOT `.env` (see edu/config.py), not this file.

# ─── Product ─────────────────────────────────────────────────────
PRODUCT=education
INSTITUTION_FILE=edu/data/institutions/xyz_international_school.json
EDU_AGENT_NAME=Aanya
EDU_AGENT_ROLE=admissions counsellor
EDU_DEFAULT_LANGUAGE=en-IN
EDU_TONE=warm
EDU_FORMALITY=medium
EDU_VERBOSITY=concise
EDU_SALES_INTENSITY=low
EDU_PATIENCE=high
EDU_MAX_CALL_TURNS=30
EDU_WIND_DOWN_TURNS=3
EDU_HISTORY_TURNS=14
EDU_MAX_CALL_COST_INR=25
EDU_CALL_WINDOW_START=09:00
EDU_CALL_WINDOW_END=20:00
EDU_MAX_ATTEMPTS_PER_LEAD=3
EDU_MIN_HOURS_BETWEEN_ATTEMPTS=24

# ─── LLM ─────────────────────────────────────────────────────────
LLM_PROVIDER=auto
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MODEL_MR=claude-sonnet-4-6

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENABLE_THINKING=false

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Sarvam ──────────────────────────────────────────────────────
SARVAM_API_KEY=

# ─── TTS / STT (EN/HI/MR = sarvam for India pilot) ───────────────
TTS_PROVIDER_EN=sarvam
TTS_PROVIDER_HI=sarvam
TTS_PROVIDER_ES=fish
STT_PROVIDER_EN=sarvam
STT_PROVIDER_HI=sarvam
STT_PROVIDER_MR=sarvam
STT_PROVIDER_ES=elevenlabs

FISH_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_SAMPLE_RATE=16000

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=wav_16000

GLADIA_API_KEY=
GLADIA_MODEL=solaria-3
STT_PROVIDER_FR=gladia
TTS_PROVIDER_FR=elevenlabs

USER_LANGUAGE=en-IN
USER_NAME=
USER_PHONE=

DB_PATH=sathi_poc.db
APP_ENV=development

TELEPHONY_PROVIDER=local
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
EXOTEL_SUBDOMAIN=api.in.exotel.com

FREJUN_API_KEY=
FREJUN_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SERVER_PORT=8000
SERVER_PUBLIC_URL=https://your-service.onrender.com
