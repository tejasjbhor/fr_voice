# ─── LLM ─────────────────────────────────────────────────────────
# auto | claude | ollama | nemotron
# auto     = Claude when CLAUDE_API_KEY is set, else Ollama
# nemotron = NVIDIA Nemotron 3 Ultra (testing — cheaper than Haiku/Sonnet)
LLM_PROVIDER=auto

# Paste your key on the next line to use Claude Haiku.
# Comment out / clear this line to fall back to Ollama (with LLM_PROVIDER=auto).
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Optional per-language model override (CLAUDE_MODEL_<LANG>).
# Marathi grammar is measurably more reliable on Sonnet; English and Hindi are
# already clean on Haiku. Comment this out to run everything on Haiku.
# Ignored when LLM_PROVIDER=nemotron.
CLAUDE_MODEL_MR=claude-sonnet-4-6

# NVIDIA Nemotron 3 Ultra (55B active) — set LLM_PROVIDER=nemotron to test.
# Restart call_server.py / main.py after flipping the switch.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENABLE_THINKING=false

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b   

# ─── Sarvam ──────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_API_KEY=

# ─── TTS provider switch ─────────────────────────────────────────
# EN/HI: sarvam | fish     ES: elevenlabs | fish     MR TTS: always sarvam
TTS_PROVIDER_EN=fish
TTS_PROVIDER_HI=fish
TTS_PROVIDER_ES=fish
TTS_PROVIDER_FR=elevenlabs

# ─── STT provider switch ─────────────────────────────────────────
# EN/HI/MR: sarvam | fish     ES: elevenlabs     FR: gladia
STT_PROVIDER_EN=sarvam
STT_PROVIDER_HI=sarvam
STT_PROVIDER_MR=sarvam
STT_PROVIDER_ES=elevenlabs
STT_PROVIDER_FR=gladia

# ─── Fish Audio (when any TTS/STT_PROVIDER_* = fish) ─────────────
FISH_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=b1a1d760d9604bdb957a56eec3460f1b
FISH_AUDIO_REFERENCE_ID_EN=
FISH_AUDIO_REFERENCE_ID_HI=
FISH_AUDIO_REFERENCE_ID_ES=
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_SAMPLE_RATE=16000

# ─── ElevenLabs (when STT/TTS_PROVIDER_ES=elevenlabs) ────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=l1zE9xgNpUTaQCZzpNJa
ELEVENLABS_VOICE_NAME=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=wav_16000

# ─── Gladia (French STT, USER_LANGUAGE=fr-FR) ────────────────────
GLADIA_API_KEY=
GLADIA_MODEL=solaria-3
GLADIA_API_URL=https://api.gladia.io
GLADIA_POLL_INTERVAL_MS=250

# ─── Language ────────────────────────────────────────────────────
# mr-IN = Marathi | hi-IN = Hindi | en-IN = English | es-ES = Spanish | fr-FR = French
USER_LANGUAGE=mr-IN
USER_NAME=Rohit
# YOUR personal mobile that should RING (NOT the ExoPhone)
USER_PHONE=
#USER_PHONE=

# ─── Database ────────────────────────────────────────────────────
DB_PATH=sathi_poc.db
# DATABASE_URL=postgresql+psycopg://sathi:sathi@localhost:5432/sathi
APP_ENV=development

# ─── Audio ───────────────────────────────────────────────────────
RECORD_MODE=vad
SILENCE_SECONDS=1.8
SILENCE_THRESHOLD=350
RECORD_MAX_SECONDS=45
RECORD_SECONDS=12
AUDIO_SAMPLE_RATE=16000

# ─── Call recording ──────────────────────────────────────────────
# true = save one WAV with your speech + Sathi replies (recordings/)
RECORD_CALL=true
RECORDINGS_DIR=recordings

# ─── Latency ─────────────────────────────────────────────────────
THINKING_SOUND_THRESHOLD_MS=1200
THINKING_SOUND_ENABLED=true
MAX_CALL_SECONDS=0

# ─── Timeouts ────────────────────────────────────────────────────
STT_TIMEOUT=30
TTS_TIMEOUT=30
LLM_TIMEOUT=30

# ─── Telephony provider ──────────────────────────────────────────
# exotel | frejun | twilio   (phone — optional; local mic needs none)
TELEPHONY_PROVIDER=local

# ─── Exotel ──────────────────────────────────────────────────────
# Account SID from Exotel → API Credentials (Mumbai / api.in.exotel.com)
EXOTEL_ACCOUNT_SID=