# ─── LLM ─────────────────────────────────────────────────────────
# auto   = use Claude if CLAUDE_API_KEY is set, else local Ollama
# claude = force Claude Haiku API (requires key below)
# ollama = force local Ollama (ignores Claude key)
LLM_PROVIDER=auto

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-haiku-4-5

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Sarvam ──────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── ElevenLabs (Spanish es-ES only) ─────────────────────────────
# Required when USER_LANGUAGE=es-ES. Marathi / Hindi / English use Sarvam.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Set voice ID directly, OR set name and leave ID blank:
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_OUTPUT_FORMAT=wav_16000

# ─── Language ────────────────────────────────────────────────────
# mr-IN = Marathi | hi-IN = Hindi | en-IN = English | es-ES = Spanish (experimental)
USER_LANGUAGE=mr-IN
USER_NAME=Ramesh
# Optional phone for India outbound (E.164, e.g. +9198XXXXXXXX)
USER_PHONE=

# ─── Database ────────────────────────────────────────────────────
# Local PoC (default): SQLite file — leave DATABASE_URL blank
DB_PATH=sathi_poc.db
# Early production / Postgres:
# DATABASE_URL=postgresql+psycopg://sathi:sathi@localhost:5432/sathi
# APP_ENV=development | production
APP_ENV=development

# ─── Audio ───────────────────────────────────────────────────────
RECORD_MODE=vad
SILENCE_SECONDS=1.8
SILENCE_THRESHOLD=350
RECORD_MAX_SECONDS=45
RECORD_SECONDS=12
AUDIO_SAMPLE_RATE=16000

# ─── Call recording ──────────────────────────────────────────────
RECORD_CALL=true
RECORDINGS_DIR=recordings

# ─── Latency ─────────────────────────────────────────────────────
# Time from the caller falling silent to her first "hmm...".
THINKING_SOUND_THRESHOLD_MS=500
THINKING_SOUND_ENABLED=true
# If the real reply still hasn't started after the first filler, speak a
# fresh one every THINKING_SOUND_REPEAT_MS, up to THINKING_SOUND_MAX_REPEATS
# extra times — otherwise a slow turn (e.g. Marathi's Sonnet override) goes
# dead silent and sounds like the call dropped.
THINKING_SOUND_REPEAT_MS=2500
THINKING_SOUND_MAX_REPEATS=2

# ─── Ending the call ─────────────────────────────────────────────
# Wall-clock ceiling on one call, in seconds. 0 = no limit. Checked at the
# end of a turn, so it never cuts her off mid-sentence.
MAX_CALL_SECONDS=0

# Sentences the goodbye turn may run to. Lower than MAX_REPLY_PHRASES on
# purpose — this audio is the last thing between the caller and the hang-up.
FAREWELL_MAX_PHRASES=2
MAX_REPLY_PHRASES=4

# Dead air, in 100ms chunks. 80 = ask "are you still there?" after 8s;
# 200 = hang up after 20s of hearing nothing at all.
SILENCE_PROMPT_CHUNKS=80
SILENCE_HANGUP_CHUNKS=200

# Also terminate the call through the provider's REST API after closing the
# WebSocket. The close alone is supposed to end the leg, but Exotel has been
# seen holding it open afterwards — which leaves the caller on a live, silent,
# billing line. Leave this on; set it to false only to debug the socket path.
PROVIDER_HANGUP_ENABLED=true

# ─── Timeouts ────────────────────────────────────────────────────
STT_TIMEOUT=30
TTS_TIMEOUT=30
LLM_TIMEOUT=30

# ─── Telephony provider ──────────────────────────────────────────
# local  = dummy calls on PC (no Twilio) — Android app + /local-call/<id>
# twilio | exotel | frejun = real phone calls
TELEPHONY_PROVIDER=twilio
# For local Android Studio testing:
# TELEPHONY_PROVIDER=local
# Emulator Backend URL in app Profile: http://10.0.2.2:8000
# PC browser after Call: http://127.0.0.1:8000/local-call/<session_id>

# ─── Exotel ──────────────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=EXxxxxxxxxxxxxxxxxxxxxxxx
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=+91XXXXXXXXXX
EXOTEL_SUBDOMAIN=api.in.exotel.com

# ─── FreJun Teler ────────────────────────────────────────────────
FREJUN_API_KEY=your_frejun_teler_api_key
FREJUN_FROM_NUMBER=+91XXXXXXXXXX
FREJUN_CHUNK_SIZE=500
FREJUN_RECORD=true

# ─── Twilio (US / international Media Streams) ───────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── Server + public URL (Twilio / Exotel / FreJun) ──────────────
# Local: ngrok http 8000 → paste https URL below
# Cloud (Render): set to https://your-service.onrender.com (no trailing slash)
# Mobile demo dialer: GET /demo  (name + phone + language → Call)
SERVER_PORT=8000
SERVER_PUBLIC_URL=https://your-service.onrender.com

# ─── Mobile app / admin (test) ───────────────────────────────────
# Development login code. Ignored in production unless ALLOW_TEST_OTP=1.
TEST_OTP=123456
ADMIN_PIN=2499
PLAN_PRICE_INR=499
# HMAC secret for session tokens (falls back to TWILIO_AUTH_TOKEN)
APP_SECRET=change-me-to-a-long-random-string

# Production: do not accept 123456. Internal QA can set ALLOW_TEST_OTP=1.
# ALLOW_TEST_OTP=0

# Optional SMS via existing Twilio numbers (trial only texts verified numbers).
# There is no free India-wide SMS we can ship. Leave this off until you have keys.
SMS_OTP=false

# Old /demo page may dial any number only if this is true. Keep off for the app.
# Pilot / Render client demos: set true so /demo and curl /call/outbound work without login.
OPEN_DIALER=false

# Daily calls run inside the web process. Catch-up window if Render was asleep.
# Concurrency pilot / Render demo: set 0 so the scheduler does not burn Twilio/Sarvam.
SCHEDULER_ENABLED=0
SCHEDULER_CATCHUP_MINUTES=120
# Optional: POST /api/scheduler/tick with header x-cron-secret (cron-job.org)
# CRON_SECRET=change-me

# Call recordings stay on local disk (not S3). On Render, attach a disk to this path.
RECORDINGS_DIR=recordings

# ─── Product ─────────────────────────────────────────────────────
# health | inbound | education
PRODUCT=health
INBOUND_AGENT_NAME=Sathi
INBOUND_SERVICE_NAME=Sathi Helpline
INBOUND_DEFAULT_LANGUAGE=hi-IN

# ─── Concurrency (2–8 call pilot) ────────────────────────────────
# 0 = unlimited. Pilot uses 8; 9th call busy-out / 503 on outbound.
MAX_CONCURRENT_CALLS=8
CALL_SLOTS_BACKEND=memory
SARVAM_STT_MAX_INFLIGHT=8
SARVAM_TTS_MAX_INFLIGHT=8
SARVAM_STT_POOL_LIMIT=8
SARVAM_TTS_POOL_LIMIT=8
CLAUDE_MAX_INFLIGHT=8
OUTBOUND_PROVIDER=twilio
OUTBOUND_CPS=1
AUTO_DIAL_ON_START=false

